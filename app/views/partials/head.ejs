<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        <%= title %> - Tour Booking
    </title>
    <link rel="stylesheet" href="/style.css">
    <script src="/app.js" defer></script>
</head>

<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="brand"><span>🌏</span> Tour Booking</div>
            <nav class="menu">
                <a href="/" class="<%= active === 'dashboard' ? 'active' : '' %>">📊 Dashboard</a>
                <% if (user && user.role==='admin' ) { %>
                    <a href="/tours" class="<%= active === 'tours' ? 'active' : '' %>">🧭 Quản lý Tour du lịch</a>
                    <a href="/bookings" class="<%= active === 'bookings' ? 'active' : '' %>">🗓️ Đơn đặt tour</a>
                    <a href="/customers" class="<%= active === 'customers' ? 'active' : '' %>">👥 Khách hàng</a>
                    <% } else { %>
                        <a href="/my-bookings" class="<%= active === 'my-bookings' ? 'active' : '' %>">🎫 Tour đã
                            đặt</a>
                        <% } %>
                            <a href="/settings" class="<%= active === 'settings' ? 'active' : '' %>">⚙️ Cài đặt</a>
            </nav>
        </aside>
        <div class="content">
            <header class="topbar">
                <div class="userbox">
                    <span>
                        <%= user.name %>
                    </span>
                    <span class="role-tag">
                        <%= user.role==='admin' ? 'Quản trị viên' : 'Khách hàng' %>
                    </span>
                    <form method="post" action="/logout" class="inline"><button class="logout">Đăng xuất</button></form>
                </div>
            </header>
            <main class="page">